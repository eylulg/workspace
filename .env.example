# Postgres connection string. Leave empty locally to use PGlite (an embedded Postgres in WebAssembly).
# On Vercel use the pooled Neon connection string (secret), which ends in ?sslmode=require.
DATABASE_URL=

# Where PGlite stores data when DATABASE_URL is empty. Use "memory" for a throwaway in-memory database.
PGLITE_DIR=.pglite

# Secret (any long random string). Vercel Cron sends it as a bearer token to /api/cron/cleanup-demo every night.
CRON_SECRET=

# Optional PostHog analytics. Nothing is loaded when the key is empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
